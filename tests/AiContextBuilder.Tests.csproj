    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>/usr/lib/dotnet/sdk/10.0.112/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
