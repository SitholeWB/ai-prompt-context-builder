{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI (C# CustomerService)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/orchestrator/cli/bin/Debug/net10.0/aicontext.dll",
      "args": [
        "generate",
        "--file",
        "${workspaceFolder}/tests/fixtures/dotnet/CustomerService.cs",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Debug Acceptance Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tests/bin/Debug/net10.0/AiContextBuilder.Tests.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ]
}
